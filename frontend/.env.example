# frontend 환경변수 템플릿 (커밋 대상)
# 실제 값은 frontend/.env.local 에 넣고 절대 커밋하지 않는다. 이 파일은 플레이스홀더만 유지한다.
# Next.js는 브라우저에 노출되는 변수에 NEXT_PUBLIC_ 접두사가 필수다.
# anon 키는 공개 전제 키라 NEXT_PUBLIC_ 로 둬도 되지만,
# Supabase service_role 키는 절대 프론트엔드에 두지 않는다.
#
# 두 Supabase 변수가 모두 없으면 로그인은 로컬 데모 세션, 대시보드는 mock-data.ts를 사용한다.
# Vercel 배포 시 같은 변수를 Vercel 프로젝트 Environment Variables 에도 등록해야 한다.
# 이메일 매직링크를 쓰려면 Supabase Auth Redirect URLs에 로컬/배포 `/login` URL을 등록한다.

# --- Supabase (프론트: anon 키만) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# --- 백엔드 API 주소 ---
# 로컬 개발 기본값. 배포 환경에서는 실제 백엔드 주소를 단일 값으로 설정한다.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
