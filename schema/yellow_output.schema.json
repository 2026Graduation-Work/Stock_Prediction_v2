{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/2026Graduation-Work/Stock-Prediction/schema/yellow_output.schema.json",
  "title": "Yellow Block Output Schema",
  "description": "노란색 블록(설문/사용자 프로파일링)이 초록색 블록으로 넘기는 표준 인터페이스. v0.2 (회의 ② 검토용)",
  "version": "0.2.0-draft",
  "type": "object",
  "required": ["user_id", "session_id", "timestamp", "investor_profile", "psychological_state", "context", "meta"],
  "properties": {
    "user_id": {
      "type": "string",
      "description": "사용자 식별자"
    },
    "session_id": {
      "type": "string",
      "description": "설문 세션 식별자"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "설문 완료 시각 (ISO 8601)"
    },
    "investor_profile": {
      "type": "object",
      "description": "이 사람이 누구인가 — RRTTLLU 기반 (R·T·L)",
      "required": ["risk_tolerance", "time_horizon_months", "liquidity_need_ratio", "target_return_annual", "investment_experience_years"],
      "properties": {
        "risk_tolerance": {
          "type": "number", "minimum": 0, "maximum": 1,
          "description": "위험 감수도. 0=극도로 보수적, 1=극도로 공격적"
        },
        "time_horizon_months": {
          "type": "integer", "minimum": 0,
          "description": "투자 기간 (개월)"
        },
        "liquidity_need_ratio": {
          "type": "number", "minimum": 0, "maximum": 1,
          "description": "유동성 필요도. 0=장기 묶어둠 OK, 1=급히 빼야 함"
        },
        "target_return_annual": {
          "type": "number",
          "description": "연 목표 수익률. 0.10 = 10%"
        },
        "investment_experience_years": {
          "type": "number", "minimum": 0,
          "description": "투자 경험 (년)"
        }
      }
    },
    "psychological_state": {
      "type": "object",
      "description": "지금 이 사람 심리 상태 — 행동재무학 핵심 지표",
      "required": ["fomo_index", "panic_sell_tendency", "herding_score", "self_confidence", "current_market_anxiety", "overheating_caution"],
      "properties": {
        "fomo_index": {
          "type": "number", "minimum": 0, "maximum": 1,
          "description": "FOMO(소외 불안) 강도"
        },
        "panic_sell_tendency": {
          "type": "number", "minimum": 0, "maximum": 1,
          "description": "패닉셀 경향"
        },
        "herding_score": {
          "type": "number", "minimum": 0, "maximum": 1,
          "description": "군집행동 점수"
        },
        "self_confidence": {
          "type": "number", "minimum": 0, "maximum": 1,
          "description": "본인 판단 신뢰도"
        },
        "current_market_anxiety": {
          "type": "number", "minimum": 0, "maximum": 1,
          "description": "시장 불안 강도. [회의 ② 안건] 노란색 설문 vs 초록색 FinBERT 중 누가 채울지 미정"
        },
        "overheating_caution": {
          "type": "number", "minimum": 0, "maximum": 1,
          "description": "과열 경계. [회의 ② 안건] 교수님 코멘트 반영. 측정 방식 미정"
        }
      }
    },
    "free_text_signal": {
      "type": "object",
      "description": "[v0.2 신규 안건] 자유 텍스트 1문항에서 LLM이 추출한 추가 시그널. 회의 ②에서 채택 여부 결정",
      "properties": {
        "raw_text": {
          "type": "string",
          "description": "사용자가 입력한 원문"
        },
        "extracted_signals": {
          "type": "object",
          "description": "원문에서 LLM이 추출한 행동재무학 시그널 (psychological_state 보정용)"
        },
        "conflict_with_survey": {
          "type": "boolean",
          "description": "객관식 응답과 자유 텍스트가 모순되는지 여부. true면 사용자 재확인 필요"
        }
      }
    },
    "confidence_per_field": {
      "type": "object",
      "description": "[v0.2 신규 안건] 각 필드별 추출 신뢰도 (0~1). 화이트박스 원칙 강화. 낮은 값은 추가 확인 대상",
      "additionalProperties": {
        "type": "number", "minimum": 0, "maximum": 1
      }
    },
    "context": {
      "type": "object",
      "description": "사용자가 현재 보고 있는 투자 맥락",
      "required": ["target_ticker", "investment_amount_krw", "action_intent"],
      "properties": {
        "target_ticker": {
          "type": "string",
          "description": "대상 종목/지수 코드. [회의 ② 안건] 기업 vs 지수 미정이라 현재 TBD"
        },
        "investment_amount_krw": {
          "type": "integer", "minimum": 0,
          "description": "투자 예정 금액 (원)"
        },
        "action_intent": {
          "type": "string",
          "enum": ["buy_consideration", "sell_consideration", "hold_consideration"],
          "description": "사용자의 현재 의도"
        },
        "market_regime_hint": {
          "type": "string",
          "description": "시장 상태 힌트 (선택)"
        }
      }
    },
    "meta": {
      "type": "object",
      "required": ["schema_version", "source"],
      "properties": {
        "schema_version": {
          "type": "string",
          "description": "스키마 버전"
        },
        "source": {
          "type": "string",
          "const": "yellow_block"
        },
        "confidence": {
          "type": "number", "minimum": 0, "maximum": 1,
          "description": "전체 응답 신뢰도 (개별 필드는 confidence_per_field 참조)"
        }
      }
    }
  }
}
