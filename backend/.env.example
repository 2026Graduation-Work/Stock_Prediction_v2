# backend 환경변수 템플릿 (커밋 대상)
# 실제 값은 backend/.env 에 넣고 절대 커밋하지 않는다. 이 파일은 플레이스홀더만 유지한다.
# analysis/text 는 python-dotenv(find_dotenv)로 실행 위치에서 상위로 올라가며 .env를 찾으므로
# backend/.env 하나로 블록 전체를 커버할 수 있다.

# ═══════════════════════════════════════════════════════════════════
# 현재 사용 중 — analysis/text (value_pipeline/config.py 가 읽음)
# 전부 선택사항: 키가 없으면 동봉 샘플·규칙 기반으로 동작한다.
# ═══════════════════════════════════════════════════════════════════

# LLM 뉴스 감성·재무 분석 — https://aistudio.google.com (무료 티어)
GEMINI_API_KEY=your-gemini-api-key-here
# 기본값 gemini-2.5-flash. 바꿀 때만 설정.
# GEMINI_MODEL=gemini-2.5-flash

# 재무제표(DART 공시) — https://opendart.fss.or.kr (무료 발급)
DART_API_KEY=your-dart-api-key-here

# 뉴스 검색 — https://developers.naver.com (검색 API, 무료)
NAVER_CLIENT_ID=your-naver-client-id-here
NAVER_CLIENT_SECRET=your-naver-client-secret-here

# KR-FinBERT 감성 폴백 (HuggingFace, 키 불필요). 끄려면 0.
# USE_FINBERT=1
# FINBERT_MODEL=snunlp/KR-FinBert-SC

# ═══════════════════════════════════════════════════════════════════
# 도입 예정 — 연결하는 코드가 생길 때 주석을 풀고 사용한다.
# 아직 어떤 코드도 읽지 않는 변수들이므로 값을 넣어도 효과 없음.
# ═══════════════════════════════════════════════════════════════════

# --- Supabase (DB·인증, PostgreSQL + pgvector) ---
# SUPABASE_URL=https://your-project-ref.supabase.co
# service_role 키는 RLS를 우회하는 슈퍼유저 수준 키다. 백엔드에서만 쓰고
# 프론트엔드·클라이언트 코드에 절대 노출하지 않는다.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# 복잡한 조회·조인용 직접 연결 (Dashboard → Settings → Database → Connection string)
# DATABASE_URL=postgresql://postgres.your-ref:your-password@your-host:5432/postgres

# --- LLM API (Claude / OpenAI — 기술 스택 예정) ---
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here

# --- 시장 데이터 ---
# yfinance는 키 불필요. KRX 정보데이터시스템 API 연동 시:
# KRX_API_KEY=your-krx-api-key-here
